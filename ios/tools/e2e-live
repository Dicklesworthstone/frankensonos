#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
binary="$PWD/../target/release/fsonos"
rows="1 2 6 7 8 9 10 11 12 13 15 17 19 20 21 22 23 24 25"
scratch=$(mktemp -d /private/tmp/fsonos-live.XXXXXX)
sim_pid= serve_pid= monitor_pid= bonjour_pid= stub_pid=
cleanup() {
    trap - EXIT INT TERM
    if [[ -s "$scratch/serve.pid" ]]; then serve_pid=$(cat "$scratch/serve.pid"); fi
    for pid in "$stub_pid" "$bonjour_pid" "$monitor_pid" "$serve_pid" "$sim_pid"; do
        if [[ -n "$pid" ]]; then kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; fi
    done
    for row in $rows; do
        if ! /usr/bin/grep -Eq "^(PASS|FAIL) row $row:" "$scratch/checks.log" 2>/dev/null; then
            echo "FAIL row $row: infrastructure or compilation prevented this scenario"
        fi
    done
    echo "Logs: $scratch"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
[[ -x "$binary" ]] || { echo "FAIL: release fsonos missing at $binary"; exit 1; }
free_port() {
    /usr/bin/perl -MIO::Socket::INET -e '$s=IO::Socket::INET->new(LocalAddr=>"127.0.0.1",LocalPort=>0,Listen=>1) or die $!; print $s->sockport'
}
port=$(free_port)
export FSONOS_DAEMON_URL="http://127.0.0.1:$port"
export FSONOS_E2E_CONTROL="$scratch/control"
export FSONOS_TAILSCALE=off FSONOS_EVENTS_PORT=0
# Rows 20 and 21: a daemon whose policy refuses the live stream, the way the NAS did for a LAN caller.
stub_port=$(free_port)
export FSONOS_E2E_STUB_URL="http://127.0.0.1:$stub_port"
python3 -I tools/stub-daemon.py "$stub_port" >/dev/null 2>&1 &
stub_pid=$!
# Row 19: advertise the daemon the way the NAS's avahi does, with a real Bonjour registration. It publishes this
# Mac's LAN address, not the loopback one the test daemon listens on, so the row checks the name, port and an IPv4
# host and never connects. (A loopback proxy registration resolves by name but never shows up in a browse.)
export FSONOS_E2E_BONJOUR_NAME="FrankenSonos E2E $$" FSONOS_E2E_BONJOUR_PORT="$port"
dns-sd -R "$FSONOS_E2E_BONJOUR_NAME" _fsonos._tcp local "$port" path=/ >/dev/null 2>&1 &
bonjour_pid=$!
"$binary" sim --scenario s2 --seeds-out "$scratch/seeds.toml" >"$scratch/sim.log" 2>&1 &
sim_pid=$!
for ((i=0; i<200; i++)); do
    [[ -s "$scratch/routes.toml" ]] && break
    kill -0 "$sim_pid" || { cat "$scratch/sim.log"; exit 1; }
    sleep 0.1
done
start_serve() {
    "$binary" serve --http "127.0.0.1:$port" --mcp-http 127.0.0.1:0 \
        --seeds "$scratch/seeds.toml" --routes "$scratch/routes.toml" \
        --data-dir "$scratch/data" --wait 1 >>"$scratch/serve.log" 2>&1 &
    serve_pid=$!
    echo "$serve_pid" >"$scratch/serve.pid"
    for ((i=0; i<200; i++)); do
        curl --noproxy '*' -fsS "$FSONOS_DAEMON_URL/health" >"$scratch/health.json" 2>/dev/null && return
        kill -0 "$serve_pid" || { cat "$scratch/serve.log"; return 1; }
        sleep 0.1
    done
    return 1
}
start_serve
# The Swift check requests stop/start so it can observe the real lifecycle.
(
    while true; do
        command=$(cat "$FSONOS_E2E_CONTROL" 2>/dev/null || true)
        case "$command" in
            stop)
                kill "$serve_pid" 2>/dev/null || true
                # This subshell did not start the daemon, so `wait` cannot see it: poll until it is gone.
                for ((i=0; i<150; i++)); do kill -0 "$serve_pid" 2>/dev/null || break; sleep 0.1; done
                echo stopped >"$FSONOS_E2E_CONTROL"
                ;;
            start)
                # The port can stay bound for a moment after the old daemon exits; retry the bind.
                for ((attempt=0; attempt<40; attempt++)); do
                    start_serve && break
                    sleep 0.25
                done
                echo started >"$FSONOS_E2E_CONTROL"
                ;;
        esac
        sleep 0.1
    done
) &
monitor_pid=$!
set +e
FSONOS_LIVE_CHECKS=1 SWIFTPM_MODULECACHE_OVERRIDE=/private/tmp/frankensonos-module-cache \
    CLANG_MODULE_CACHE_PATH=/private/tmp/frankensonos-module-cache \
    swift test --disable-sandbox --filter LiveChecks >"$scratch/checks.log" 2>&1
result=$?
set -e
cat "$scratch/checks.log"
if [[ -s "$scratch/serve.pid" ]]; then serve_pid=$(cat "$scratch/serve.pid"); fi
exit "$result"
