# FrankenSonos environment — copy to `.env` (git-ignored) and fill in locally.
# Never commit real values. These are the owner's own credentials/settings.

# Spotify Web API (read-only library access, Authorization Code + PKCE).
# The client id is created at https://developer.spotify.com/dashboard for your
# own app. For PKCE the client id is not a secret; the refresh token IS and is
# cached in the local data dir, not here.
FSONOS_SPOTIFY_CLIENT_ID=
FSONOS_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8099/auth/spotify/callback

# Where the daemon binds its HTTP API and MCP HTTP transport. Bind loopback
# and/or your Tailscale interface address; never a public interface.
FSONOS_HTTP_ADDR=127.0.0.1:8099
FSONOS_MCP_HTTP_ADDR=127.0.0.1:8098

# Optional: path to a local, git-ignored direct-seed list for networks where
# SSDP multicast is unreliable (TOML of player IPs). Discovery still runs.
# FSONOS_SEEDS=local/seeds.toml

# Log level (tracing EnvFilter syntax).
RUST_LOG=info
